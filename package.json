    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "openai": "^7.8.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vinext": "^1.0.0-beta.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
