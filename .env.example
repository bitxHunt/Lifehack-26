# Copy to .env and fill in. For local dev, `pnpm db:dev` starts a Postgres
# and prints ready-made values for both of these.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/agentshelf?schema=public"

# Only needed for `prisma migrate dev` against a hosted database.
SHADOW_DATABASE_URL=""

# Optional. Powers "Create listing" (photo + notes -> drafted page copy) with a
# real Claude call. Without it, that tab falls back to a deterministic template
# so the demo still works offline.
ANTHROPIC_API_KEY=""
