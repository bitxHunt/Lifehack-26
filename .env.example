OPENAI_API_KEY=
# Terra is the default reasoning-heavy discovery/ranking model.
OPENAI_DISCOVERY_MODEL="gpt-5.6-terra"
OPENAI_DISCOVERY_EFFORT="high"
# Luna handles the repetitive 100-case shopper simulation branch.
OPENAI_ADVERSARIAL_MODEL="gpt-5.6-luna"
OPENAI_ADVERSARIAL_EFFORT="low"
# For a quality-first demo, set OPENAI_DISCOVERY_MODEL="gpt-5.6-sol".
NEXT_PUBLIC_SITE_URL="http://pickme-lifehack.vercel.app"
CATALOG_DB_PATH="data/catalog/amazon-fashion-demo.sqlite"
