// AgentShelf data model.
//
// This mirrors the shapes in `lib/types.ts` and the demo data currently
// hardcoded in `lib/catalog.ts`. The split that matters is on Product:
//
//   content -> the words actually on the product page. All the agent reads.
//   truths  -> what the product really is. The agent never sees this.
//
// Facets are a fixed vocabulary, so they are an enum rather than a table.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// One dimension of shopper intent. Mirrors `FacetId` in lib/types.ts.
enum FacetId {
  humidity
  lightweight
  long_distance
  cushioning
  wet_grip
  wide_feet
  durability
  sizing
  returns
  sustainability
  local_availability
  price_clarity
}

model Product {
  id       String  @id
  name     String
  brand    String
  priceSgd Decimal @map("price_sgd") @db.Decimal(10, 2)
  /// True for the brand we are optimising for.
  isOurs   Boolean @default(false) @map("is_ours")

  /// The lines of copy on the live page, in order.
  content String[]

  /// What the product genuinely is, one row per facet it can honestly claim.
  truths  ProductTruth[]
  /// Sentences added to the page during the fix loop.
  patches Patch[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isOurs])
  @@map("products")
}

/// A true, publishable claim a product could make but may not have made yet.
model ProductTruth {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  facet     FacetId
  /// Publishable copy, straight from the spec sheet.
  statement String

  @@unique([productId, facet])
  @@map("product_truths")
}

/// A shopper question, written the way people actually talk to an assistant.
model Query {
  id       String   @id
  text     String
  /// Budget ceiling in SGD, or null when the shopper did not name one.
  maxPrice Decimal? @map("max_price") @db.Decimal(10, 2)

  weights QueryWeight[]

  @@map("queries")
}

/// How much one facet matters for one query.
model QueryWeight {
  id      String @id @default(cuid())
  queryId String @map("query_id")
  query   Query  @relation(fields: [queryId], references: [id], onDelete: Cascade)

  facet  FacetId
  weight Int

  @@unique([queryId, facet])
  @@map("query_weights")
}

/// A sentence added to a product page to close a gap the agent could see.
model Patch {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// The facet this sentence was meant to cover, when it targeted one.
  facet    FacetId?
  sentence String

  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@map("patches")
}
